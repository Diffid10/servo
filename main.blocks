<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="ysdQJH,`fL+/^F~dWBzg" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="iQ684nzUMN]zvpj!C]bp"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace Servo_Advaune {" line1="" line2="    // เก็บองศาปัจจุบันแยกตามแต่ละพิน แทน currentAngle ตัวเดียวที่ใช้ร่วมกันผิด ๆ" line3="    let angleState: number[] = []" line4="" line5="    function getCurrentAngle(pin: AnalogPin): number {" line6="        if (angleState[pin] == undefined) {" line7="            angleState[pin] = 90   // สมมติองศาเริ่มต้น ถ้ายังไม่เคยสั่งพินนี้มาก่อน" line8="        }" line9="        return angleState[pin]" line10="    }" line11="" line12="    //% blockId=servo_set_angle" line13="    //% block=&quot;servo %pin set angle %angle&quot;" line14="    //% weight=100" line15="    export function setAngle(pin: AnalogPin, angle: number): void {" line16="        if (angle &gt; 180) angle = 180" line17="        if (angle &lt; 0) angle = 0" line18="        pins.servoWritePin(pin, angle)" line19="        angleState[pin] = angle" line20="    }" line21="" line22="    //% blockId=servo_move_relative" line23="    //% block=&quot;servo %pin move %direction by %angle degrees&quot;" line24="    //% weight=90" line25="    export function moveRelative(pin: AnalogPin, direction: Direction, angle: number): void {" line26="        let target = getCurrentAngle(pin) + direction * angle" line27="        if (target &gt; 180) target = 180" line28="        if (target &lt; 0) target = 0" line29="        pins.servoWritePin(pin, target)" line30="        angleState[pin] = target" line31="    }" line32="" line33="    //% blockId=servo_move_smooth" line34="    //% block=&quot;servo %pin move smooth to %end in %time ms&quot;" line35="    //% weight=95" line36="    export function moveSmooth(pin: AnalogPin, end: number, time: number): void {" line37="        if (end &gt; 180) end = 180" line38="        if (end &lt; 0) end = 0" line39="" line40="        let start = getCurrentAngle(pin)   // ✅ ใช้ตำแหน่งจริงปัจจุบันเสมอ กันกระตุกตอนเริ่ม" line41="        let steps = Math.abs(Math.round(end - start))" line42="        if (steps == 0) return" line43="" line44="        if (time &lt;= 0) {   // ✅ กัน time&lt;=0 ทำให้ pause แปลก ๆ" line45="            pins.servoWritePin(pin, end)" line46="            angleState[pin] = end" line47="            return" line48="        }" line49="" line50="        let startTime = input.runningTime()" line51="" line52="        for (let i = 0; i &lt;= steps; i++) {" line53="            let t = i / steps" line54="            let ease = t * t * (3 - 2 * t)   // smoothstep" line55="            let angle = start + (end - start) * ease" line56="            pins.servoWritePin(pin, angle)" line57="" line58="            // ✅ เทียบเวลาจริงแทนหาร time/steps ตรง ๆ กัน drift สะสม" line59="            let targetElapsed = (time * i) / steps" line60="            let actualElapsed = input.runningTime() - startTime" line61="            let waitMs = targetElapsed - actualElapsed" line62="            if (waitMs &gt; 0) basic.pause(waitMs)" line63="        }" line64="" line65="        angleState[pin] = end   // ✅ อัปเดต state ให้ moveRelative ครั้งถัดไปคำนวณถูก" line66="    }" line67="" line68="    //% blockId=servo_tune" line69="    //% block=&quot;set servo %pin by buttons (A=+, B=-, A+B=ok)&quot;" line70="    //% weight=110" line71="    export function tuneServo(pin: AnalogPin): number {" line72="        // ⚠️ ควรเรียกฟังก์ชันนี้แค่ครั้งเดียวต่อพินตอน setup/calibration" line73="        // (MakeCode ไม่มี API ถอด handler — เรียกซ้ำจะสะสม handler เก่าไว้เรื่อย ๆ)" line74="        let angle2 = getCurrentAngle(pin)   // ✅ เริ่มจากตำแหน่งจริง ไม่ใช่ 90 ตายตัว" line75="        let done = false" line76="" line77="        pins.servoWritePin(pin, angle2)" line78="" line79="        input.onButtonPressed(Button.A, function () {" line80="            if (!done) {" line81="                angle2 += 1" line82="                if (angle2 &gt; 180) angle2 = 180" line83="                pins.servoWritePin(pin, angle2)" line84="                basic.showNumber(angle2)" line85="            }" line86="        })" line87="" line88="        input.onButtonPressed(Button.B, function () {" line89="            if (!done) {" line90="                angle2 -= 1" line91="                if (angle2 &lt; 0) angle2 = 0" line92="                pins.servoWritePin(pin, angle2)" line93="                basic.showNumber(angle2)" line94="            }" line95="        })" line96="" line97="        input.onButtonPressed(Button.AB, function () {" line98="            done = true" line99="            basic.clearScreen()" line100="        })" line101="" line102="        while (!done) {" line103="            basic.pause(50)" line104="        }" line105="" line106="        angleState[pin] = angle2   // ✅ บันทึกผลจูนกลับเข้า state กลาง" line107="        return angle2" line108="    }" line109="}" numlines="110"></mutation></block></statement></block></xml>